# .env.example
# Every variable here is read by the code (grep for it); anything not listed is not configurable.
# Copy to .env and replace each CHANGE_ME. Never commit .env.

# --- PostgreSQL 15 ------------------------------------------------------------
# docker-compose reads these three to create the database.
POSTGRES_DB=recon
POSTGRES_USER=recon_app
POSTGRES_PASSWORD=CHANGE_ME
# The application and Alembic connect with this.
DATABASE_URL=postgresql+psycopg://recon_app:CHANGE_ME@postgres:5432/recon
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
# Only read by persistence.session.get_audit_engine(), which the application does not call at
# runtime: audit entries are written in the same transaction as the change they record, through
# DATABASE_URL, and the application role has UPDATE and DELETE revoked on the audit schema.
# AUDIT_DB_USER=recon_audit
# AUDIT_DB_PASSWORD=CHANGE_ME

# --- Redis 7 (dashboard cache and rate limiting; both fail open if Redis is down) ---
REDIS_URL=redis://redis:6379/0
DASHBOARD_CACHE_TTL_SECONDS=30
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_UPLOAD_PER_MINUTE=10

# --- Files and configuration --------------------------------------------------
RECON_UPLOAD_DIR=/var/lib/recon/uploads
# Directory holding banks/, matching/, exceptions/, anomaly/, calendars/ (found automatically
# when unset).
# RECON_CONFIG_DIR=/app/config
# How often the bank configuration files are checked for changes (hot-swap), in seconds.
BANK_CONFIG_RELOAD_SECONDS=2

# --- Alert thresholds (override the values in config/anomaly/rules.yaml) --------
EXCEPTION_RATE_ALERT_THRESHOLD=0.05
SUSPICIOUS_MATCH_RATE_THRESHOLD=0.995

# --- Tests only ---------------------------------------------------------------
# Integration, golden and chaos tests and the benchmark need a database whose name ends in _test.
# TEST_DATABASE_URL=postgresql+psycopg://recon_app:CHANGE_ME@localhost:5432/recon_test
