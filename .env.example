# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=local
APP_NAME=recon
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------------------------------------------------------------------------
# Database (PostgreSQL 15+)
# ---------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=recon
POSTGRES_USER=recon_app
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://recon_app:CHANGE_ME@postgres:5432/recon
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30

# Audit log runs under a separate role with INSERT/SELECT only.
AUDIT_DB_USER=recon_audit
AUDIT_DB_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# Redis 7+
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
DASHBOARD_CACHE_TTL_SECONDS=30
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_UPLOAD_PER_MINUTE=10

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
API_KEY_HASH_ROUNDS=12

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
UPLOAD_DIR=/var/lib/recon/uploads
MAX_UPLOAD_BYTES=524288000
ALLOWED_UPLOAD_EXTENSIONS=.csv,.sta,.txt,.xml
INGEST_BATCH_SIZE=10000
CAMT_XSD_VALIDATION=sampled

# ---------------------------------------------------------------------------
# Money and rounding (see docs/DATABASE.md)
# ---------------------------------------------------------------------------
DECIMAL_ROUNDING_MODE=ROUND_HALF_EVEN
DECIMAL_PRECISION=28

# ---------------------------------------------------------------------------
# Matching (defaults; authoritative values live in config/matching/*.yaml)
# ---------------------------------------------------------------------------
CONFIG_DIR=/app/config
MATCH_AUTO_THRESHOLD=0.85
MATCH_REVIEW_THRESHOLD=0.60
MATCH_CANDIDATE_CAP=50
MATCH_BATCH_SIZE=10000
DETERMINISTIC_SEED=20260918

# ---------------------------------------------------------------------------
# Alerting thresholds (PDF A1.3, B4.4)
# ---------------------------------------------------------------------------
EXCEPTION_RATE_ALERT_THRESHOLD=0.05
SUSPICIOUS_MATCH_RATE_THRESHOLD=0.995
